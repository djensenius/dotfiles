<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.djensenius.herdr-status</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec "$HOME/.config/herdr/scripts/herdr-status-report.sh" --run-poller</string>
    </array>

    <!-- Herdr's tab-bar command only reads the shared package cache. Keep the
         tmux-outdated-packages poller alive when no tmux server is running. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/tmp/herdr-status.log</string>
</dict>
</plist>
