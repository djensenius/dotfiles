<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.djensenius.herdr-status</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>$HOME/.config/herdr/scripts/herdr-status-report.sh</string>
    </array>

    <!-- Herdr metadata tokens are display-only and never persisted, so the
         reporter restates them on a timer. The tokens carry a TTL of three
         intervals, so a dead reporter leaves no frozen readings behind. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/tmp/herdr-status.log</string>
</dict>
</plist>
